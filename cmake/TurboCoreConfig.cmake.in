@PACKAGE_INIT@

set(TurboCore_HAS_AVX2 @TURBOCORE_HAS_AVX2@)
set(TurboCore_HAS_CUDA @TURBOCORE_HAS_CUDA@)

# A static TurboCore built with CUDA carries a link-only dependency on the
# CUDA runtime, which the consumer has to resolve.
if(TurboCore_HAS_CUDA AND NOT "@BUILD_SHARED_LIBS@")
  include(CMakeFindDependencyMacro)
  find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TurboCoreTargets.cmake")

check_required_components(TurboCore)
